<Window x:Class="Win11UpdateBlocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11 Update Blocker"
        Height="760"
        Width="960"
        MinHeight="600"
        MinWidth="780"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="UpdatesPageTemplate">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Schnellauswahl" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Setzt alle Häkchen auf einmal — du kannst danach einzeln anpassen."
                                   Style="{StaticResource SectionSubtitle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Alles erlauben"
                                    Style="{StaticResource PresetChipButton}"
                                    Command="{Binding AllowAllCommand}"
                                    Margin="0,0,10,0" />
                            <Button Content="Alles blocken"
                                    Style="{StaticResource PresetChipButton}"
                                    Command="{Binding BlockAllCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Updates erlauben" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Aktiviere nur die Update-Typen, die installiert werden dürfen. Deaktivierte Typen erscheinen nicht mehr in den Windows-Update-Einstellungen."
                                   Style="{StaticResource SectionSubtitle}" />
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardItemBackgroundBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,12"
                                            Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <ToggleButton Grid.Column="1"
                                                                  Style="{StaticResource ToggleSwitch}"
                                                                  IsChecked="{Binding IsAllowed, Mode=TwoWay}"
                                                                  VerticalAlignment="Center" />
                                                </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource WarningBgBrush}"
                        BorderBrush="{StaticResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,16"
                        Visibility="{Binding ShowSecurityWarning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Sicherheitsupdates sind deaktiviert. Dein System ist anfälliger für Angriffe."
                               Foreground="{StaticResource WarningTextBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>

                <Border Background="{StaticResource InfoBgBrush}"
                        BorderBrush="{StaticResource InfoBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Windows hat Einstellungen geändert. Klicke „Einstellungen anwenden“, um deine Auswahl wiederherzustellen."
                               Foreground="{StaticResource InfoTextBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <Button Content="Einstellungen anwenden"
                        Command="{Binding ApplyCommand}"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Stretch" />
                <Button Content="Status aktualisieren"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StatusPageTemplate">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,20">
                            <TextBlock Text="Windows Update"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" />
                            <TextBlock Text="{Binding WindowsUpdateStatus}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,20">
                            <TextBlock Text="Hintergrund-Dienst"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" />
                            <TextBlock Text="{Binding BackgroundServiceStatus}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="Letzte Prüfung"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" />
                            <TextBlock Text="{Binding LastCheckText}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Content="Status aktualisieren"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Left"
                        MinWidth="200"
                        Margin="0,0,0,16" />

                <Border Background="{StaticResource DangerBgBrush}"
                        BorderBrush="{StaticResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Visibility="{Binding NeedsSystemAccessHelp, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Hintergrund-Dienst nicht erreichbar"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DangerTextBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Starte den Windows-Dienst „Win11 Update Blocker“ oder installiere die App erneut, um Änderungen anwenden zu können."
                                   Foreground="{StaticResource DangerTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SettingsPageTemplate">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Background="{StaticResource CardItemBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Hintergrund-Dienst" FontWeight="SemiBold" />
                                    <TextBlock Text="Hält deine Update-Einstellungen dauerhaft aktiv (alle 5 Minuten)."
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Settings.ServiceStatusText, StringFormat=Status: {0}}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding Settings.BackgroundServiceEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource CardItemBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Mit Windows starten" FontWeight="SemiBold" />
                                    <TextBlock Text="Startet die App automatisch nach dem Anmelden."
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding Settings.AutostartEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource CardItemBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Tray-Icon" FontWeight="SemiBold" />
                                    <TextBlock Text="Minimiert die App in den Infobereich neben der Uhr."
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding Settings.TrayEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource DangerBgBrush}"
                                BorderBrush="{StaticResource DangerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,14,0,0"
                                Visibility="{Binding NeedsSystemAccessHelp, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Der Hintergrund-Dienst ist offline. Update-Änderungen können erst wieder angewendet werden, wenn der Dienst läuft."
                                       Foreground="{StaticResource DangerTextBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Software-Update" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Prüft beim Start und alle 6 Stunden automatisch auf GitHub-Releases."
                                   Style="{StaticResource SectionSubtitle}" />
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Nach Updates suchen"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CheckForUpdateCommand}"
                                    MinWidth="160"
                                    Margin="0,0,10,0" />
                            <Button Content="Jetzt aktualisieren"
                                    Command="{Binding InstallUpdateCommand}"
                                    MinWidth="160"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Content="Einstellungen speichern"
                        Command="{Binding Settings.SaveCommand}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,24">
                    <Image Source="pack://siteoforigin:,,,/Assets/icon.png"
                           Width="40"
                           Height="40"
                           Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Win11 Update Blocker"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="NAVIGATION"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="8,0,0,10" />

                <StackPanel Grid.Row="2">
                    <Button Command="{Binding NavigateUpdatesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdatesPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource NavActiveBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="BorderBrush" Value="{StaticResource NavActiveBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Updates" />
                    </Button>

                    <Button Command="{Binding NavigateStatusCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource NavActiveBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="BorderBrush" Value="{StaticResource NavActiveBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Systemstatus" />
                    </Button>

                    <Button Command="{Binding NavigateSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource NavActiveBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="BorderBrush" Value="{StaticResource NavActiveBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Einstellungen" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Background="{StaticResource InfoBgBrush}"
                            BorderBrush="{StaticResource InfoBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,10"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="App-Update verfügbar"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InfoTextBrush}" />
                            <TextBlock Text="{Binding UpdateBannerText}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InfoTextBrush}"
                                       Margin="0,4,0,8" />
                            <Button Content="Jetzt aktualisieren"
                                    Command="{Binding InstallUpdateCommand}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding CurrentVersionText}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8" />

                    <Border Background="{StaticResource CardItemBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="Systemzugriff"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SystemAccessText}"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource AppBackgroundBrush}"
                    Padding="28,24,28,20"
                    BorderBrush="{StaticResource SidebarBorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PageSubtitle}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource AppBackgroundBrush}"
                          Padding="28,20,28,28">
                <ContentControl MaxWidth="900"
                                HorizontalAlignment="Stretch"
                                Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource UpdatesPageTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusPage}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource StatusPageTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SettingsPageTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
