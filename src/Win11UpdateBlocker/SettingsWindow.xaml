<Window x:Class="Win11UpdateBlocker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Height="480"
        Width="520"
        MinHeight="440"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Einstellungen"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="Verhalten der App und des Hintergrund-Dienstes"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Padding="16">
            <StackPanel>
                <Border Background="#F8FAFC"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,12"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Hintergrund-Dienst"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Hält deine Update-Einstellungen dauerhaft aktiv (alle 5 Minuten)."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ServiceStatusText, StringFormat=Status: {0}}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ModernCheckBox}"
                                  Content="Aktiv"
                                  IsChecked="{Binding BackgroundServiceEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Background="#F8FAFC"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,12"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Mit Windows starten"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Startet die App automatisch nach dem Anmelden."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ModernCheckBox}"
                                  Content="Aktiv"
                                  IsChecked="{Binding AutostartEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Background="#F8FAFC"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Tray-Icon"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Minimiert die App in den Infobereich neben der Uhr."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ModernCheckBox}"
                                  Content="Aktiv"
                                  IsChecked="{Binding TrayEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,14,0,0"
                        Visibility="{Binding RequiresAdminForService, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Für den Hintergrund-Dienst musst du die App als Administrator starten."
                               Foreground="#991B1B"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Abbrechen"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,10,0"
                    MinWidth="110" />
            <Button Content="Speichern"
                    Command="{Binding SaveCommand}"
                    MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
